# Copy this file to .env.local and fill in your own Supabase project values.
# Find both in your Supabase dashboard: Project Settings -> API.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: if set, the "Plan Ahead" tab asks for this passcode once per
# browser session before showing the form. This is a light deterrent for
# casual visitors, not real security -- leave it blank to skip the gate.
VITE_ADMIN_PASSCODE=
