# Copy this file to .env.local and fill in your own Supabase project values.
# Find both in your Supabase dashboard: Project Settings -> API.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# The passcode that opens the hidden planner -- type it anywhere on the
# page, or enter it after visiting #plan / tapping the header ears five
# times. Leave it blank and it falls back to "meow", so set your own.
# This hides the planner from visitors; it is not real security (the anon
# key above ships in the page either way). See the README.
VITE_ADMIN_PASSCODE=
